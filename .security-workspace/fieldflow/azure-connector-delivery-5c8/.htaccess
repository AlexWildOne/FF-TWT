# FieldFlow 9CJ fieldflow-build-tooling-web-isolation-v1
# Build, test and Azure deployment sources are shipped for certification only.
# They must never be executed or downloaded through the web server.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
Options -Indexes
